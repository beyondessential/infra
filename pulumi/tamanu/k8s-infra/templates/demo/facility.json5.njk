{
  canonicalHostName: 'https://{{ fqdn }}',
  db: {
    migrateOnStartup: false,
  },
  sync: {
    enabled: true,
    host: '{{ centralApiUrl }}',
    email: 'admin@tamanu.io',
    password: '{{ provisioning.users["admin@tamanu.io"].password }}',
    syncApiConnection: {
      host: '{{ syncApiUrl }}',
      port: {{ syncApiPort }},
    },
  },
  auth: {
    useHardcodedPermissions: false,
    secret: '{{ 40 | randomstring }}',
  },
  errors: {
    enabled: true,
  },
  proxy: {
    trusted: ['loopback', '{{ networkV4Cidr }}', '{{ networkV6Cidr }}'],
  },
  countryTimeZone: '{{ timezone }}',
  localisation: {
    timeZone: '{{ timezone }}',
  },
  serverFacilityIds: ['{{ facilityId }}'],
  deviceId: '{{ deviceId }}',
}
