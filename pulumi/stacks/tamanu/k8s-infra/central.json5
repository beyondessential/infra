{
  db: {
    migrateOnStartup: false,
  },
  auth: {
    secret: 'REDACTED',
    refreshSecret: 'REDACTED',
    reportNoUserError: true,
    useHardcodedPermissions: false,
  },
  honeycomb: {
    apiKey: 'REDACTED',
    enabled: false,
  },
  localisation: {
    data: {
      country: {
        'alpha-2': 'UT',
        'alpha-3': 'UTO',
        name: 'Utopia',
      },
      features: {
        patientPlannedMove: true,
        enablePatientDeaths: true,
        enableInvoicing: true,
        editPatientDisplayId: true,
        enableCovidClearanceCertificate: true,
        quickPatientGenerator: true,
      },
      disabledReports: [
        'aefi',
        'india-assistive-technology-device-line-list',
        'iraq-assistive-technology-device-line-list',
      ],
      imagingTypes: {
        fluroscopy: {
          label: 'Fluroscopy',
        },
        xRay: {
          label: 'X-Ray',
        },
        mri: {
          label: 'MRI',
        },
        echocardiogram: {
          label: 'Echocardiogram',
        },
        ctScan: {
          label: 'CT Scan',
        },
        ecg: {
          label: 'Electrocardiogram (ECG)',
        },
        endoscopy: {
          label: 'Endoscopy',
        },
        mammogram: {
          label: 'Mammogram',
        },
        holterMonitor: {
          label: 'Holter Monitor',
        },
        angiogram: {
          label: 'Angiogram',
        },
        colonoscopy: {
          label: 'Colonoscopy',
        },
        ultrasound: {
          label: 'Ultrasound',
        },
      },
    },
  },
  tupaiaApiClient: {
    environment: 'dev',
    auth: {
      password: 'REDACTED',
      username: 'tamanu-server@tupaia.org',
    },
  },
  mailgun: {
    apiKey: 'REDACTED',
    domain: 'tupaia.org',
    from: 'tamanu@tupaia.org',
  },
  updateUrls: {
    mobile: 'https://install.appcenter.ms/orgs/beyond-essential/apps/tamanu-mobile-only/distribution_groups/staging',
  },
  disk: {
    diskPath: '/',
    freeSpaceRequired: {
      gigabytesForUploadingDocuments: 0.1,
    },
  },
  schedules: {
    fhirMaterialiser: {
      limit: 1000,
    },
  },
  integrations: {
    vdsNc: {
      enabled: true,
    },
    signer: {
      enabled: true,
      keySecret: 'REDACTED',
    },
    fhir: {
      enabled: true,
    },
    mSupply: {
      enabled: true,
    },
  },
  notifications: {
    certificates: {
      labTestCategoryIds: ['labTestCategory-COVID', 'labTestCategory-COVIDRAT'],
    },
  },
