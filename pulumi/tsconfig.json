{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["stacks/**/*.ts"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./build",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  }
}
