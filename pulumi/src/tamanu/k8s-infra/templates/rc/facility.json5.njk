{
  db: {
    migrateOnStartup: false,
  },
  sync: {
    enabled: true,
    host: '{{ centralApiUrl }}',
    email: 'admin@tamanu.io',
    password: '{{ provisioning.users["admin@tamanu.io"].password }}'
  },
  auth: {
    useHardcodedPermissions: false,
    secret: '{{ 40 | randomstring }}',
  },
  proxy: {
    trusted: ['loopback', '{{ networkV4Cidr }}', '{{ networkV6Cidr }}'],
  },
  survey: {
    defaultCodes: {
      location: {% if instance == "facility-1" %}
        'THWaitingArea'
      {% elif instance == "facility-2" %}
        'LHWaitingArea'
      {% else %}
        'WaitingArea'
      {% endif %},
      department: 'Emergency',
    },
  },
  countryTimeZone: '{{ timezone }}',
  localisation: {
    timeZone: '{{ timezone }}',
  },
  serverFacilityId: '{{ facilityId }}',
  deviceId: '{{ deviceId }}',
}
