{
  canonicalHostName: 'https://{{ fqdn }}',
  db: {
    migrateOnStartup: false,
  },
  sync: {
    enabled: true,
    host: '{{ centralApiUrl }}',
    email: 'admin@tamanu.io',
    password: '{{ provisioning.users["admin@tamanu.io"].password }}',
    syncApiConnection: {
      host: '{{ syncApiUrl }}',
      port: {{ syncApiPort }},
    },
  },
  auth: {
    useHardcodedPermissions: false,
    secret: '{{ 40 | randomstring }}',
  },
  errors: {
    enabled: true,
  },
  proxy: {
    trusted: ['loopback', '{{ networkV4Cidr }}', '{{ networkV6Cidr }}'],
  },
  survey: {
    defaultCodes: {
      location: {% if instance == "facility-1" %}
        'THWaitingArea'
      {% elif instance == "facility-2" %}
        'LHWaitingArea'
      {% else %}
        'WaitingArea'
      {% endif %},
      department: 'Emergency',
    },
  },
  countryTimeZone: '{{ timezone }}',
  localisation: {
    timeZone: '{{ timezone }}',
  },
  serverFacilityIds: ['{{ facilityId }}'],
  deviceId: '{{ deviceId }}',
}
