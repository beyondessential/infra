TASK [tamanu-single-install : Strip non-hex ufw rule comments] *****************
changed: [tamanu-iti-2026-01-amanda] => {"changed": true, "cmd": "python3 - <<'PY'\nimport re, sys\nchanged = False\nfor path in ('/etc/ufw/user.rules', '/etc/ufw/user6.rules'):\n    try:\n        with open(path) as f:\n            content = f.read()\n    except FileNotFoundError:\n        continue\n    def clean(m):\n        return m.group(0) if re.fullmatch(r'[0-9a-fA-F]+', m.group(1)) else ''\n    new = re.sub(r' comment=(\\S+)', clean, content)\n    if new != content:\n        with open(path, 'w') as f:\n            f.write(new)\n        changed = True\nprint('CHANGED' if changed else 'UNCHANGED')\nPY\n", "delta": "0:00:00.030851", "end": "2026-05-14 22:25:51.637862", "msg": "", "rc": 0, "start": "2026-05-14 22:25:51.607011", "stderr": "", "stderr_lines": [], "stdout": "CHANGED", "stdout_lines": ["CHANGED"]}

