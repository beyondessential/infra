extensions:
  zpages:
    endpoint: localhost:55679
  file_storage/otc:
    directory: /var/log/otel
    fsync: {{ "false" if ansible_system_vendor == 'Amazon EC2' else "true" }}
    create_directory: true # for compaction.directory
    compaction:
      cleanup_on_start: true
      on_start: true
      on_rebound: true
      directory: /tmp/otel

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: localhost:4317
      http:
        endpoint: localhost:4318
  hostmetrics:
    scrapers:
      cpu:
      disk:
      filesystem:
      load:
      memory:
      network:
      process:
      processes:
      paging:

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 1000
  batch:
    timeout: 5s
    send_batch_max_size: 9900 # AWS maximum is 10k
  resource:
    attributes:
{% if tailscale_name is defined %}
      - key: deployment.tailscale
        value: {{ tailscale_name }}
        action: upsert
{% endif %}
{% if tamanu_version is defined %}
      - key: deployment.purpose
        value: tamanu
        action: upsert
{% endif %}

exporters:
  debug:
    verbosity: detailed
{% if otlp_logs_endpoint is defined and otlp_logs_endpoint %}
  otlp{{ "http" if "http" in otlp_logs_endpoint else "" }}/logs:
    endpoint: {{ otlp_logs_endpoint }}
    sending_queue:
      storage: file_storage/otc
      queue_size: 100000
{% endif %}
{% if otlp_metrics_endpoint is defined and otlp_metrics_endpoint %}
  otlp{{ "http" if "http" in otlp_metrics_endpoint else "" }}/metrics:
    endpoint: {{ otlp_metrics_endpoint }}
    sending_queue:
      storage: file_storage/otc
      queue_size: 100000
{% endif %}
{% if otlp_traces_endpoint is defined and otlp_traces_endpoint %}
  otlp{{ "http" if "http" in otlp_traces_endpoint else "" }}/traces:
    endpoint: {{ otlp_traces_endpoint }}
    sending_queue:
      storage: file_storage/otc
      queue_size: 100000
{% endif %}
{% if cloudwatch_enabled %}
  awsxray:
  awscloudwatchmetrics:
  awscloudwatchlogs:
{% endif %}

service:
  extensions: [zpages, file_storage/otc]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [resource, memory_limiter, batch]
      exporters:
{% if cloudwatch_enabled %}
        - awsxray
{% elif otlp_traces_endpoint is defined and otlp_traces_endpoint %}
        - otlp{{ "http" if "http" in otlp_traces_endpoint else "" }}/traces
{% else %}
        - debug
{% endif %}

    metrics:
      receivers: [hostmetrics, otlp]
      processors: [resource, memory_limiter, batch]
      exporters:
{% if cloudwatch_enabled %}
        - awscloudwatchmetrics
{% elif otlp_metrics_endpoint is defined and otlp_metrics_endpoint %}
        - otlp{{ "http" if "http" in otlp_metrics_endpoint else "" }}/metrics
{% else %}
        - debug
{% endif %}

    logs:
      receivers: [otlp]
      processors: [resource, memory_limiter, batch]
      exporters:
{% if cloudwatch_enabled %}
        - awscloudwatchlogs
{% elif otlp_logs_endpoint is defined and otlp_logs_endpoint %}
        - otlp{{ "http" if "http" in otlp_logs_endpoint else "" }}/logs
{% else %}
        - debug
{% endif %}
