[Unit]
Description=Iti core temperature monitoring
After=network.target iti-lcd-server.service
Requires=iti-lcd-server.service

[Service]
ExecStart=/usr/bin/iti-bestool --log-timeless iti temperature --watch 10sec --json --update-screen 195
Restart=always
RestartSec=60s

[Install]
WantedBy=multi-user.target
