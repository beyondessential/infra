[Unit]
Description=Advertise mSupply as a Tailscale service
After=network-online.target tailscaled.service
Wants=network-online.target msupply.service
Requires=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/bin/wait-for-tailscale
ExecStart=/usr/bin/tailscale serve --service={{ msupply_tailscale_service }} --https=443 http://127.0.0.1:8000
ExecStart=/usr/bin/tailscale serve --service={{ msupply_tailscale_service }} --http=80 http://127.0.0.1:8000
ExecStop=/usr/bin/tailscale serve --service={{ msupply_tailscale_service }} off
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
