#!/usr/bin/env python3
"""Munin multigraph plugin: basic Caddy metrics.

Scrapes Caddy's Prometheus admin endpoint locally and emits a curated, low-
cardinality subset in Munin format: per-vhost request rate and in-flight
requests, plus Caddy's own process memory. Caddy's full metrics (latency
histograms, many-label series) don't map onto Munin's flat model and are
deliberately not exposed here.

Config: set env.url in plugin-conf.d to override the endpoint.
"""
import hashlib
import os
import re
import sys
import urllib.request

URL = os.environ.get("url", "http://localhost:2019/metrics")

_LINE = re.compile(r"^(?P<name>[a-zA-Z_:][a-zA-Z0-9_:]*)(?:\{(?P<labels>[^}]*)\})?\s+(?P<val>\S+)")
_LABEL = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')


def scrape():
    with urllib.request.urlopen(URL, timeout=10) as resp:
        text = resp.read().decode("utf-8", "replace")
    out = {}
    for line in text.splitlines():
        if not line or line[0] == "#":
            continue
        m = _LINE.match(line)
        if not m:
            continue
        try:
            val = float(m.group("val"))
        except ValueError:
            continue
        labels = dict(_LABEL.findall(m.group("labels") or ""))
        out.setdefault(m.group("name"), []).append((labels, val))
    return out


def field(host):
    """A stable, munin-legal field name for a vhost, hashed when long."""
    safe = re.sub(r"[^A-Za-z0-9]", "_", host)
    if len(safe) > 40:
        safe = safe[:33] + "_" + hashlib.md5(host.encode()).hexdigest()[:6]
    return "h_" + safe


def by_host(series):
    agg = {}
    for labels, val in series:
        host = labels.get("host", "unknown")
        agg[host] = agg.get(host, 0.0) + val
    return sorted(agg.items())


def config(metrics):
    print("multigraph caddy_requests")
    print("graph_title Caddy requests")
    print("graph_category caddy")
    print("graph_vlabel requests / ${graph_period}")
    print("graph_args --base 1000 --lower-limit 0")
    for host, _ in by_host(metrics.get("caddy_http_requests_total", [])):
        f = field(host)
        print(f"{f}.label {host}")
        print(f"{f}.type DERIVE")
        print(f"{f}.min 0")

    print("\nmultigraph caddy_requests_in_flight")
    print("graph_title Caddy requests in flight")
    print("graph_category caddy")
    print("graph_vlabel requests")
    print("graph_args --base 1000 --lower-limit 0")
    for host, _ in by_host(metrics.get("caddy_http_requests_in_flight", [])):
        f = field(host)
        print(f"{f}.label {host}")
        print(f"{f}.type GAUGE")
        print(f"{f}.min 0")

    print("\nmultigraph caddy_memory")
    print("graph_title Caddy process memory")
    print("graph_category caddy")
    print("graph_vlabel bytes")
    print("graph_args --base 1024 --lower-limit 0")
    print("rss.label resident set size")
    print("rss.type GAUGE")
    print("rss.min 0")


def values(metrics):
    print("multigraph caddy_requests")
    for host, val in by_host(metrics.get("caddy_http_requests_total", [])):
        print(f"{field(host)}.value {int(val)}")

    print("\nmultigraph caddy_requests_in_flight")
    for host, val in by_host(metrics.get("caddy_http_requests_in_flight", [])):
        print(f"{field(host)}.value {val:g}")

    print("\nmultigraph caddy_memory")
    rss = metrics.get("process_resident_memory_bytes")
    if rss:
        print(f"rss.value {int(rss[0][1])}")


def main():
    metrics = scrape()
    if len(sys.argv) > 1 and sys.argv[1] == "config":
        config(metrics)
        if os.environ.get("MUNIN_CAP_DIRTYCONFIG") == "1":
            values(metrics)
    else:
        values(metrics)


if __name__ == "__main__":
    main()
