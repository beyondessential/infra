[Unit]
Description=Take a snapshot of caddy config
ConditionPathExists=/var/lib/kopia/.config/kopia/repository.config

[Service]
Type=oneshot
User=kopia
Group=kopia
Environment=KOPIA_CHECK_FOR_UPDATES=false
ExecStart=kopia snapshot create --tags area:caddy-config --description="%H Caddy config" /etc/caddy
