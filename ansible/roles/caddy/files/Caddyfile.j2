{
	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}

  admin localhost:2019

  storage file_system {
    root /var/lib/caddy
  }

  log {
    output stdout
  }

  email {{ caddy_email }}

  {% if caddy_zerossl_api_key is defined %}
  cert_issuer zerossl {{ caddy_zerossl_api_key }}
  {% endif %}

	cert_issuer acme
}

(bind80) {
  bind fd/3 {
		protocols h1
	}
}

import /etc/caddy/servers/*
