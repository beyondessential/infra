{
	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}

  admin localhost:2019

  # with socket activation, caddy attempts to redirect to port 0
  # which obviously doesn't work. instead we redir manually.
  auto_https disable_redirects

  storage file_system {
    root /var/lib/caddy
  }

  log {
    output stdout
  }

  email {{ caddy_email }}

  {% if caddy_zerossl_api_key is defined %}
  cert_issuer zerossl {{ caddy_zerossl_api_key }}
  {% endif %}

	cert_issuer acme

	order coraza_waf first
}

(bind80) {
  bind fd/3 {
		protocols h1
	}
}

(waf) {
  coraza_waf {
    load_owasp_crs
    directives `
      Include @coraza.conf-recommended
      Include @crs-setup.conf.example
      Include @owasp_crs/*.conf

      {% if caddy_waf_enforce %}
      SecRuleEngine On
      {% else %}
      SecRuleEngine DetectionOnly
      {% endif %}

      SecRequestBodyLimit 104857600
      SecResponseBodyMimeType text/plain text/html text/xml application/json
    `
  }
}

import /etc/caddy/servers/*
