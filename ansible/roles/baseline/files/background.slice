# IOWeight requires bfq or io.cost on the underlying block device to take
# effect; on the default mq-deadline scheduler it is inert. CPUWeight works
# regardless. Nice / IOSchedulingClass=idle / OOMScoreAdjust are
# process-level and live in per-service drop-ins, not here.

[Unit]
Description=Background workloads (backups, package updates, FS maintenance)
Before=slices.target

[Slice]
CPUWeight=20
IOWeight=20
