# IOWeight requires bfq or io.cost on the underlying block device to take
# effect; on the default mq-deadline scheduler it is inert. CPUWeight works
# regardless. Nice / IOSchedulingClass / OOMScoreAdjust are process-level
# and live in per-service drop-ins, not here.

[Unit]
Description=Critical workloads (tamanu API, postgres, caddy)
Before=slices.target

[Slice]
CPUWeight=200
IOWeight=200
# Memory is the only resource that has taken a facility node down (TAM-7048).
# MemoryMin is a reclaim-protection floor: the kernel won't reclaim pages from
# this slice (postgres, tamanu API, caddy) below this figure under pressure,
# so a munin/cron spike sheds its own cache first. Conservative fleet-wide
# floor; size up on hosts with more RAM.
MemoryMin=512M
