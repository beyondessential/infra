[Unit]
Description=Take a snapshot of postgres (ext4 method)
ConditionPathExists=/var/lib/kopia/.config/kopia/repository.config

[Service]
Type=oneshot
User=kopia
Group=kopia
Environment=PGDATA=/var/lib/kopia/pgdata
Environment=TMPDIR=/run/kopia
ExecStart=!mkdir -p $TMPDIR
ExecStart=!chown kopia:kopia $TMPDIR
ExecStart=!/usr/bin/bindfs -r -u kopia /var/lib/postgresql/current $PGDATA
ExecStart=/var/lib/kopia/backup-postgres.sh
ExecStopPost=-!/usr/bin/fusermount -u $PGDATA
ExecStopPost=-!rm -rf $TMPDIR
Slice=background.slice
Nice=19
IOSchedulingClass=idle
OOMScoreAdjust=500
