#!/bin/bash

set -euo pipefail

# bes-setup-kopia: Interactive script to configure kopia backup credentials
# This script is installed by Ansible but run manually by operators to provide secrets

CONFIG_FILE="/var/lib/kopia/.config/kopia/repository.config"
KOPIA_USER="kopia"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    log_error "Please run as root (use sudo)"
    exit 1
fi

# Check if already configured
if [ -f "$CONFIG_FILE" ]; then
    log_info "Kopia is already configured on this host"
    log_info "Configuration: $CONFIG_FILE"
    echo ""
    read -p "Do you want to reconfigure? This will delete existing configuration. [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "Exiting without changes"
        exit 0
    fi

    log_warn "Removing existing configuration..."
    rm -f "$CONFIG_FILE"
fi

# Check if kopia user exists
if ! id "$KOPIA_USER" &>/dev/null; then
    log_error "Kopia user '$KOPIA_USER' does not exist"
    log_error "Please run Ansible to set up kopia first"
    exit 1
fi

# Detect if this is a central host or facility host
IS_CENTRAL=false
if [ -f /etc/systemd/system/kopia-maintenance.service ] || [ -f /usr/lib/systemd/system/kopia-maintenance.service ]; then
    IS_CENTRAL=true
fi

log_info "=== Kopia Configuration Setup ==="
echo ""

# Prompt for repository creation or connection
if [ "$IS_CENTRAL" = true ]; then
    DEFAULT_CREATE="Y"
    PROMPT_TEXT="Create new repository? [Y/n]: "
else
    DEFAULT_CREATE="N"
    PROMPT_TEXT="Create new repository? [y/N]: "
fi

read -p "$PROMPT_TEXT" -n 1 -r CREATE_REPO
echo
if [ -z "$CREATE_REPO" ]; then
    CREATE_REPO="$DEFAULT_CREATE"
fi

if [[ $CREATE_REPO =~ ^[Yy]$ ]]; then
    REPO_ACTION="create"
    log_info "Will create a new kopia repository"
else
    REPO_ACTION="connect"
    log_info "Will connect to an existing kopia repository"
fi

echo ""

# Prompt for S3 bucket
read -p "S3 Bucket name: " S3_BUCKET
if [ -z "$S3_BUCKET" ]; then
    log_error "S3 bucket is required"
    exit 1
fi

# Prompt for S3 region
read -p "S3 Region [ap-southeast-2]: " S3_REGION
S3_REGION=${S3_REGION:-ap-southeast-2}

# Prompt for S3 credentials
read -p "S3 Access Key: " S3_KEY
if [ -z "$S3_KEY" ]; then
    log_error "S3 access key is required"
    exit 1
fi

# Read S3 secret with asterisk feedback
echo -n "S3 Secret Key: "
S3_SECRET=""
while IFS= read -r -s -n1 char; do
    if [[ $char == $'\0' ]]; then
        break
    elif [[ $char == $'\177' ]]; then
        if [ ${#S3_SECRET} -gt 0 ]; then
            S3_SECRET="${S3_SECRET%?}"
            echo -ne "\b \b"
        fi
    else
        S3_SECRET+="$char"
        echo -n "*"
    fi
done
echo
if [ -z "$S3_SECRET" ]; then
    log_error "S3 secret key is required"
    exit 1
fi

# Read kopia password with asterisk feedback
echo -n "Kopia Repository Password: "
KOPIA_PASSWORD=""
while IFS= read -r -s -n1 char; do
    if [[ $char == $'\0' ]]; then
        break
    elif [[ $char == $'\177' ]]; then
        if [ ${#KOPIA_PASSWORD} -gt 0 ]; then
            KOPIA_PASSWORD="${KOPIA_PASSWORD%?}"
            echo -ne "\b \b"
        fi
    else
        KOPIA_PASSWORD+="$char"
        echo -n "*"
    fi
done
echo
if [ -z "$KOPIA_PASSWORD" ]; then
    log_error "Kopia repository password is required"
    exit 1
fi

# Confirm kopia password with asterisk feedback
echo -n "Confirm Kopia Repository Password: "
KOPIA_PASSWORD_CONFIRM=""
while IFS= read -r -s -n1 char; do
    if [[ $char == $'\0' ]]; then
        break
    elif [[ $char == $'\177' ]]; then
        if [ ${#KOPIA_PASSWORD_CONFIRM} -gt 0 ]; then
            KOPIA_PASSWORD_CONFIRM="${KOPIA_PASSWORD_CONFIRM%?}"
            echo -ne "\b \b"
        fi
    else
        KOPIA_PASSWORD_CONFIRM+="$char"
        echo -n "*"
    fi
done
echo
if [ "$KOPIA_PASSWORD" != "$KOPIA_PASSWORD_CONFIRM" ]; then
    log_error "Passwords do not match"
    exit 1
fi

echo ""
log_info "Configuring kopia..."

# Create or connect to repository
if [ "$REPO_ACTION" = "create" ]; then
    log_info "Creating repository..."

    sudo -u "$KOPIA_USER" env KOPIA_PASSWORD="$KOPIA_PASSWORD" KOPIA_CHECK_FOR_UPDATES=false kopia repository create s3 \
        --bucket="$S3_BUCKET" \
        --access-key="$S3_KEY" \
        --secret-access-key="$S3_SECRET" \
        --region="$S3_REGION" \
        --ecc-overhead-percent=1 \
        --retention-mode=GOVERNANCE \
        --retention-period=30d
else
    log_info "Connecting to existing repository..."

    sudo -u "$KOPIA_USER" env KOPIA_PASSWORD="$KOPIA_PASSWORD" KOPIA_CHECK_FOR_UPDATES=false kopia repository connect s3 \
        --bucket="$S3_BUCKET" \
        --access-key="$S3_KEY" \
        --secret-access-key="$S3_SECRET" \
        --region="$S3_REGION"
fi

# Set compression policy
log_info "Setting compression policy..."
sudo -u "$KOPIA_USER" env KOPIA_CHECK_FOR_UPDATES=false kopia policy set --compression=zstd-fastest --add-ignore 'lost+found' --global

# Check available disk space and set cache limits for small disks
AVAILABLE_GB=$(df -BG /var/lib/kopia | tail -1 | awk '{print $4}' | sed 's/G//')

if [ "$AVAILABLE_GB" -lt 10 ]; then
    log_info "Small disk detected (${AVAILABLE_GB}GB available), setting cache limits..."
    sudo -u "$KOPIA_USER" env KOPIA_CHECK_FOR_UPDATES=false kopia cache set --content-cache-size-limit-mb=3000
    sudo -u "$KOPIA_USER" env KOPIA_CHECK_FOR_UPDATES=false kopia cache set --metadata-cache-size-limit-mb=1000
    log_info "Cache limits configured (3GB content, 1GB metadata)"
else
    log_info "Sufficient disk space available (${AVAILABLE_GB}GB), using default cache settings"
fi

echo ""
log_info "=== Kopia configuration complete! ==="
log_info "Backup services will now start automatically"
log_info "You can verify with: systemctl status kopia-*.timer"
echo ""
