[Unit]
Description=Expire old Kopia snapshots
ConditionPathExists=/var/lib/kopia/.config/kopia/repository.config

[Service]
Type=oneshot
User=kopia
Group=kopia
Environment=KOPIA_CHECK_FOR_UPDATES=false
ExecStart=kopia snapshot expire
Slice=background.slice
Nice=19
IOSchedulingClass=idle
OOMScoreAdjust=500
