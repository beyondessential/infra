[Unit]
Description=Tamanu alert daemon
After=network.target

[Service]
Type=simple
User=tamanu
Group=tamanu
SupplementaryGroups=systemd-journal
# Distinct journal identifier so rsyslog can filter alertd apart from other
# bestool invocations (which all otherwise log as "bestool").
SyslogIdentifier=bestool-alertd
# Alert checks are built into bestool; there is no on-disk alert config.
ExecStart=/usr/bin/bestool tamanu alertd run
MemoryMax=500M
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
