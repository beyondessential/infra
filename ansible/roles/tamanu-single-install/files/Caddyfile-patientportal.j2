(patient_portal_server) {
  log {
    output stdout
  }

  header / Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip
  import waf*

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    to http://api-1.central.tamanu.internal:3000
    to http://api-2.central.tamanu.internal:3000

    fail_duration 15s
    lb_policy least_conn
    lb_retries 2
    lb_try_duration 5s
    health_uri /api/public/ping

    transport http {
      keepalive 65s
      compression false
    }
  }

  reverse_proxy /* {
    header_up Host "localhost"
    to http://patientportal.central.tamanu.internal:3000

    fail_duration 10s
    lb_policy least_conn
    lb_retries 2
    lb_try_duration 5s
    health_uri /
    health_headers {
      Host "localhost"
    }

    transport http {
      keepalive 65s
      compression false
    }
  }
}

{% if tamanu_caddy_tls and not (patient_portal_fqdn | regex_search('\\.local$')) %}
https://{{ patient_portal_fqdn }} {
  import patient_portal_server
}
http://{{ patient_portal_fqdn }} {
  import bind80
  redir https://{host}{uri} 308
}
{% else %}
http://{{ patient_portal_fqdn }} {
  import bind80
  import patient_portal_server
}
{% endif %}
