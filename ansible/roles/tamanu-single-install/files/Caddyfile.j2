(server) {
  log {
    output stdout
  }

  header / Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip

  redir /v1/login /api/login 308

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    dynamic a api.{{ tamanu_server_type }}.tamanu.internal 3000 {
      resolvers 10.100.0.1
      {% if not tamanu_ipv6 %}
      versions ipv4
      {% endif %}
    }

    fail_duration 15s
    lb_policy least_conn
    health_uri /api/public/ping

    transport http {
      keepalive 65s
    }
  }

  reverse_proxy /* {
    header_up Host "localhost"

    dynamic a frontend.tamanu.internal 3000 {
      resolvers 10.100.0.1
      {% if not tamanu_ipv6 %}
      versions ipv4
      {% endif %}
    }

    fail_duration 10s
    lb_policy least_conn
    health_uri /
    health_headers {
      Host "localhost"
    }

    transport http {
      keepalive 65s
    }
  }
}

http:// {
  import bind80
  import server
}

{% if tamanu_caddy_tls and not (public_hostname | regex_search('\\.local$')) %}
{{ public_hostname }} {
  import server
}
http://{{ public_hostname }} {
  import bind80
  redir https://{host}{uri} 308
}
{% endif %}

{% if tailscale_name is defined %}
{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
  tls {
    get_certificate tailscale
  }
}
http://{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
}
{% endif %}
