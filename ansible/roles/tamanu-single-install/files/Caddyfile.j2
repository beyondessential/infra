(server) {
  log {
    output stdout
  }

  header / Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip
  import waf*
  redir /v1/login /api/login 308
  rewrite /socket.io* /api/socket.io?{query}

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    to http://api-1.{{ tamanu_server_type }}.tamanu.internal:3000
    to http://api-2.{{ tamanu_server_type }}.tamanu.internal:3000

    fail_duration 15s
    lb_policy least_conn
    lb_retries 2
    lb_try_duration 5s
    health_uri /api/public/ping

    transport http {
      keepalive 65s
      compression false
    }
  }

  reverse_proxy /* {
    header_up Host "localhost"
    to http://frontend-a.tamanu.internal:3000
    to http://frontend-b.tamanu.internal:3000

    fail_duration 10s
    lb_policy least_conn
    lb_retries 2
    lb_try_duration 5s
    health_uri /
    health_headers {
      Host "localhost"
    }

    transport http {
      keepalive 65s
      compression false
    }
  }
}

http:// {
  import bind80
  import server
}

{% if tamanu_caddy_tls and not (public_hostname | regex_search('\\.local$')) %}
https://{{ public_hostname }} {
  import server
}
http://{{ public_hostname }} {
  import bind80
  redir https://{host}{uri} 308
}
{% endif %}

{% if tailscale_name is defined %}
https://{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
  tls {
    get_certificate tailscale
  }
}
{% endif %}
