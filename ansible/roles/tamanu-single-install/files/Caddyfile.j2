(server) {
  log {
    output stdout
  }

  header / Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip

  reverse_proxy /* {
    header_up Host "localhost"

    dynamic a frontend.tamanu.internal 3000 {
      resolvers 10.100.0.1
    }

    fail_duration 10s
    lb_policy least_conn
    health_uri /
    health_headers {
      Host "localhost"
    }

    transport http {
      keepalive 65s
    }
  }

  header /v1/* Cache-Control no-store
  reverse_proxy /v1/* {
    dynamic a api.{{ tamanu_server_type }}.tamanu.internal 3000 {
      resolvers 10.100.0.1
    }

    fail_duration 15s
    lb_policy least_conn
    health_uri /api/public/ping

    transport http {
      keepalive 65s
    }
  }

  header /api/* Cache-Control no-store
  reverse_proxy /api/* {
    dynamic a api.{{ tamanu_server_type }}.tamanu.internal 3000 {
      resolvers 10.100.0.1
    }

    fail_duration 15s
    lb_policy least_conn
    health_uri /api/public/ping

    transport http {
      keepalive 65s
    }
  }
}

:80 {
  import server
}

{% if not (public_hostname | regex_search('\\.local$')) %}
{{ public_hostname }} {
  import server
}
{% endif %}

{% if tailscale_name is defined %}
{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
  tls {
    get_certificate tailscale
  }
}
{% endif %}
