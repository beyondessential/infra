[Unit]
Description=Tamanu Central FHIR worker (resolve)

[Container]
EnvironmentFile=/etc/tamanu/env
Image=ghcr.io/beyondessential/tamanu-central:${TAMANU_VERSION}
Exec=startFhirWorker --topics=fhir.resolver
Volume=/etc/tamanu/${TAMANU_VERSION}:/config
Volume=/var/run/postgresql:/var/run/postgresql
Sysctl=net.ipv4.tcp_slow_start_after_idle=0

[Service]
EnvironmentFile=/etc/tamanu/env
Restart=always
RestartSec=5
