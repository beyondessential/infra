[Unit]
Description=Take a snapshot of tamanu config
ConditionPathExists=/var/lib/kopia/.config/kopia/repository.config

[Service]
Type=oneshot
RemainAfterExit=yes
User=kopia
Group=tamanu
Environment=KOPIA_CHECK_FOR_UPDATES=false
ExecStart=kopia snapshot create --description="%H Tamanu config" /etc/tamanu
