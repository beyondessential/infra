{
  // THIS FILE IS AUTOGENERATED BY ANSIBLE
  // Modifications will be overwritten!
  // Use the production.json5 instead.

  proxy: {
    trusted: "loopback, linklocal, uniquelocal",
  },

  db: {
    name: "{{ tamanu_db_name }}",
    verbose: false,
    username: "{{ tamanu_db_user }}",
    password: "{{ lookup('ansible.builtin.password', '/dev/null', seed = ansible_facts['machine_id'] + salt + 'postgres' + tamanu_db_user, chars=['ascii_letters', 'digits']) }}",
    host: "/var/run/postgresql",
    port: null,
    migrateOnStartup: false,
    reportSchemas: {
      connections: {
        raw: {
          username: "raw",
          password: "{{ lookup('ansible.builtin.password', '/dev/null', seed = ansible_facts['machine_id'] + salt + 'postgres' + 'raw', chars=['ascii_letters', 'digits']) }}",
        },
        reporting: {
          username: "reporting",
          password: "{{ lookup('ansible.builtin.password', '/dev/null', seed = ansible_facts['machine_id'] + salt + 'postgres' + 'reporting', chars=['ascii_letters', 'digits']) }}",
        },
      },
    },
  },

  {% if bestool_installed_version is defined and bestool_installed_version is version('1.8.0', '>=') %}
  // bestool sends status to the meta server from the host (via the
  // bestool-doctor.timer on < 1.11.0, or the bestool-alertd daemon on >=
  // 1.11.0), so disable the in-app sender.
  schedules: {
    sendStatusToMetaServer: {
      enabled: false,
    },
  },
  {% endif %}

  {% if tamanu_server_type == 'central' %}
  disk: {
    diskPath: '/var/lib/postgresql',
  },
  {% if patient_portal_enabled %}
  patientPortal: {
    portalUrl: "https://{{ patient_portal_fqdn }}",
  },
  {% endif %}
  {% else %}
  sync: {
    syncApiConnection: {
      host: 'http://syncapi.facility.tamanu.internal',
      port: 3000,
    },
  },
  {% endif %}
}
