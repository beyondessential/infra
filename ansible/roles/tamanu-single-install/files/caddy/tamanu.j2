(server) {
  log {
    output stdout
  }

  @root_only path /
  header @root_only Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip
  import waf*
  redir /v1/login /api/login 308

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    import upstream_api
  }

  reverse_proxy /env.js {
    header_down Cache-Control "public, max-age=604800, immutable"
    import upstream_frontend
  }

  reverse_proxy /* {
    import upstream_frontend
  }
}

http:// {
  import bind80
  import server
}

{% if tamanu_caddy_tls and not (public_hostname | regex_search('\\.local$')) %}
https://{{ public_hostname }} {
  import server
}
http://{{ public_hostname }} {
  import bind80
  redir https://{host}{uri} 308
}
{% endif %}

{% if tailscale_name is defined %}
https://{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
  tls {
    get_certificate tailscale
  }
}
{% endif %}
