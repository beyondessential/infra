(upstream_frontend) {
  header_up Host "localhost"
  to http://frontend-a.tamanu.internal:3000
  to http://frontend-b.tamanu.internal:3000

  fail_duration 10s
  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s
  health_uri /
  health_headers {
    Host "localhost"
  }

  transport http {
    keepalive 90s
    compression false
  }
}

{% if patient_portal_enabled %}
(upstream_patientportal) {
  header_up Host "localhost"
  to http://patientportal.tamanu.internal:3000

  transport http {
    keepalive 90s
    compression false
  }
}
{% endif %}

(upstream_api) {
  to http://api-1.{{ tamanu_server_type }}.tamanu.internal:3000
  to http://api-2.{{ tamanu_server_type }}.tamanu.internal:3000

  fail_duration 15s
  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s
  health_uri /api/public/ping

  transport http {
    keepalive 90s
    compression false
  }
}
