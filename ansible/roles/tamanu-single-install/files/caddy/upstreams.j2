(upstream_frontend) {
  header_up Host "localhost"
  dynamic a {
    name frontend.tamanu.internal
    port 3000
    versions ipv4
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}

{% if patient_portal_enabled %}
(upstream_patientportal) {
  header_up Host "localhost"
  dynamic a {
    name patientportal.tamanu.internal
    port 3000
    versions ipv4
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}
{% endif %}

(upstream_api) {
  dynamic a {
    name api.{{ tamanu_server_type }}.tamanu.internal
    port 3000
    versions ipv4
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}
