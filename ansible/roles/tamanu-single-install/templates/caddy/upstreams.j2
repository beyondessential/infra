{# Each `dynamic a` block below sets `resolvers` to aardvark_dns so caddy resolves
   *.tamanu.internal via podman's aardvark-dns directly, bypassing the host's
   systemd-resolved which is intermittently slow (seconds) for these lookups and
   stalls requests inside caddy.

   aardvark-dns (podman's in-network DNS) listens on the podman network gateway,
   defined in roles/podman/defaults/main.yml as podman_network_subnets_v4[0].gateway.
   That role runs in a separate play, so the var isn't in scope here; fall back to
   the literal, which must stay in sync with the podman network gateway. #}
{% set aardvark_dns = podman_network_subnets_v4[0].gateway | default('10.100.0.1') %}
(upstream_frontend) {
  header_up Host "localhost"
  dynamic a {
    name frontend.tamanu.internal
    port 3000
    versions ipv4
    resolvers {{ aardvark_dns }}
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}

{% if patient_portal_enabled %}
(upstream_patientportal) {
  header_up Host "localhost"
  dynamic a {
    name patientportal.tamanu.internal
    port 3000
    versions ipv4
    resolvers {{ aardvark_dns }}
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}
{% endif %}

(upstream_api) {
  dynamic a {
    name api.{{ tamanu_server_type }}.tamanu.internal
    port 3000
    versions ipv4
    resolvers {{ aardvark_dns }}
  }

  lb_policy least_conn
  lb_retries 2
  lb_try_duration 5s

  transport http {
    keepalive 90s
    compression false
  }
}
