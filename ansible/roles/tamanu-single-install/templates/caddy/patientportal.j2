(patient_portal_server) {
  log {
    output stdout
  }

  @root_only path /
  header @root_only Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  encode zstd gzip
  import waf*

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    import upstream_api
  }

  reverse_proxy /* {
    import upstream_patientportal
  }
}

{% if tamanu_caddy_tls and not (patient_portal_fqdn | regex_search('\\.local$')) %}
https://{{ patient_portal_fqdn }} {
  import patient_portal_server
}
http://{{ patient_portal_fqdn }} {
  import bind80
  redir https://{host}{uri} 308
}
{% else %}
http://{{ patient_portal_fqdn }} {
  import bind80
  import patient_portal_server
}
{% endif %}
