(server) {
  log {
    output stdout
  }

  # excludes upgrade requests: forcing Connection on a 101 breaks the websocket handshake
  @http11 {
    protocol http/1.1
    header !Upgrade
  }
  header @http11 >Connection "keep-alive"
  header @http11 >Keep-Alive "timeout=90"


  @root_only path /
  header @root_only Cache-Control no-cache
  header /manifest.json Cache-Control no-cache

  handle_errors {
    @custom_err file /resources/errors/{err.status_code}.html
    handle @custom_err {
      rewrite * {file_match.relative}
      file_server
    }
  }

  {% if tamanu_version is defined and tamanu_version.startswith('v') and (tamanu_version | regex_replace('^v', '')) is version_compare('2.48.0', '<') %}
  @socket_io_paths {
    path /socket.io*
    path /api/socket.io*
  }

  handle @socket_io_paths {
    respond 405
  }
  {% endif %}

  encode zstd gzip
  import waf*
  redir /v1/login /api/login 308

  @api {
    path /v1/*
    path /api/*
  }

  rate_limit @api {
    log_key
    zone per_ip {
      key {remote_host}
      events 1000
      window 1s
    }
  }

  route /api/login {
    rate_limit {
      log_key
      zone auth_per_ip {
        key {remote_host}
        events 10
        window 1s
      }
    }
  }

  header @api Cache-Control no-store
  reverse_proxy @api {
    import upstream_api
  }

  reverse_proxy /env.js {
    header_down Cache-Control "public, max-age=604800, immutable"
    import upstream_frontend
  }

  reverse_proxy /* {
    import upstream_frontend
  }
}

http:// {
  import bind80
  import server
}

{% if tamanu_caddy_tls and not (public_hostname | regex_search('\\.local$')) %}
https://{{ public_hostname }} {
  import server
}
http://{{ public_hostname }} {
  import bind80
  redir https://{host}{uri} 308
}
{% endif %}

{% if tailscale_name is defined and tamanu_tailscale_tls %}
https://{{ tailscale_name }}.{{ tailnet }}.ts.net {
  import server
  tls {
    get_certificate tailscale
  }
}
{% endif %}

{% for hostname in tamanu_caddy_extra_hostnames %}
  {% if tamanu_caddy_tls and not (hostname | regex_search('\.local$')) %}
    {% if tamanu_caddy_extra_hostnames_redirect %}
https://{{ hostname }} {
  redir https://{{ public_hostname }}{uri} 308
}
http://{{ hostname }} {
  import bind80
  redir https://{{ public_hostname }}{uri} 308
}
    {% else %}
https://{{ hostname }} {
  import server
}
http://{{ hostname }} {
  import bind80
  redir https://{host}{uri} 308
}
    {% endif %}
  {% else %}
    {% if tamanu_caddy_extra_hostnames_redirect %}
http://{{ hostname }} {
  import bind80
  redir http://{{ public_hostname }}{uri} 308
}
    {% else %}
http://{{ hostname }} {
  import bind80
  import server
}
    {% endif %}
  {% endif %}
{% endfor %}
