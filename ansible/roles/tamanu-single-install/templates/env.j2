# this is controlled by Ansible and will be overwritten if you make changes
TZ={{ timezone }}
PROXY_TRUSTED=loopback,linklocal,uniquelocal
TAMANU_VERSION={{ tamanu_version }}
TAMANU_VERSION_DOMAIN={{ tamanu_version | replace('.', '-') }}
TAMANU_FRONTEND_VERSION={{ tamanu_frontend_version }}
TAMANU_FRONTEND_VERSION_DOMAIN={{ tamanu_frontend_version | replace('.', '-') }}
DATABASE_URL=postgresql://{{ tamanu_db_user }}:{{ lookup('ansible.builtin.password', '/dev/null', seed=ansible_facts['machine_id'] + salt + 'postgres' + tamanu_db_user, chars=['ascii_letters', 'digits']) }}@/{{ tamanu_db_name }}?host=/var/run/postgresql
