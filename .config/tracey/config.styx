@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name pgsnap
        include (docs/spec/pgsnap.md)
        impls (
            {
                name main
                include (
                    pgsnap/src/**/*.rs
                )
            }
        )
    }
    {
        name kubernetes
        include (docs/spec/kubernetes/*.md)
        impls (
            {
                name main
                include (
                    pulumi/k8s-core/**/*.ts
                    pulumi/k8s-essentials/**/*.ts
                    pulumi/common/k8s/**/*.ts
                    pulumi/policies/rules/**/*.ts
                )
                exclude (
                    pulumi/common/k8s/**/*.test.ts
                    pulumi/policies/rules/**/*.test.ts
                )
                test_include (
                    pulumi/common/k8s/**/*.test.ts
                    pulumi/policies/rules/**/*.test.ts
                )
            }
        )
    }
    {
        name tamanu-renderer
        include (docs/spec/tamanu/*.md)
        impls (
            {
                name main
                include (
                    pulumi/tamanu/on-k8s/src/**/*.ts
                    pulumi/tamanu/k8s-infra/**/*.ts
                    pulumi/common/k8s/argoPlugin.ts
                )
                exclude (
                    pulumi/tamanu/on-k8s/src/**/*.test.ts
                )
                test_include (
                    pulumi/tamanu/on-k8s/src/**/*.test.ts
                )
            }
        )
    }
)
