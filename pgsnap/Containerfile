FROM alpine:latest AS certs
RUN apk add --no-cache ca-certificates

FROM debian:bookworm-slim AS gcclibs
RUN cp /lib/*-linux-gnu/libgcc_s.so.1 /libgcc_s.so.1

FROM busybox:glibc

COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=gcclibs /libgcc_s.so.1 /lib/libgcc_s.so.1

ARG TARGETPLATFORM

COPY --chmod=755 amd64/ /tmp/bins/amd64/
COPY --chmod=755 arm64/ /tmp/bins/arm64/

RUN if [ "$TARGETPLATFORM" = "linux/amd64" ]; then \
      cp /tmp/bins/amd64/* /usr/bin/; \
    elif [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
      cp /tmp/bins/arm64/* /usr/bin/; \
    else \
      echo "Unknown platform: $TARGETPLATFORM"; exit 1; \
    fi && \
    rm -rf /tmp/bins

USER operator
ENTRYPOINT ["operator"]
