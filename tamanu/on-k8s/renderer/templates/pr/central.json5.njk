{
  canonicalHostName: 'https://{{ fqdn }}',
  db: {
    migrateOnStartup: false,
  },
  auth: {
    secret: '{{ 40 | randomstring }}',
    refreshSecret: '{{ 40 | randomstring }}',
    reportNoUserError: true,
    useHardcodedPermissions: false,
  },
  proxy: {
    trusted: ['loopback', '{{ networkV4Cidr }}', '{{ networkV6Cidr }}'],
  },
  localisation: {
    data: {
      country: {
        'alpha-2': 'UT',
        'alpha-3': 'UTO',
        name: 'Utopia',
      },
      features: {
        patientPlannedMove: true,
        enablePatientDeaths: true,
        enableInvoicing: true,
        editPatientDisplayId: true,
        enableCovidClearanceCertificate: true,
        quickPatientGenerator: true,
      },
      disabledReports: [
        'aefi',
        'india-assistive-technology-device-line-list',
        'iraq-assistive-technology-device-line-list',
      ],
      imagingTypes: {
        fluroscopy: {
          label: 'Fluroscopy',
        },
        xRay: {
          label: 'X-Ray',
        },
        mri: {
          label: 'MRI',
        },
        echocardiogram: {
          label: 'Echocardiogram',
        },
        ctScan: {
          label: 'CT Scan',
        },
        ecg: {
          label: 'Electrocardiogram (ECG)',
        },
        endoscopy: {
          label: 'Endoscopy',
        },
        mammogram: {
          label: 'Mammogram',
        },
        holterMonitor: {
          label: 'Holter Monitor',
        },
        angiogram: {
          label: 'Angiogram',
        },
        colonoscopy: {
          label: 'Colonoscopy',
        },
        ultrasound: {
          label: 'Ultrasound',
        },
      },
    },
  },
  tupaiaApiClient: {
    environment: 'dev',
  },
  updateUrls: {
    mobile: 'https://install.appcenter.ms/orgs/beyond-essential/apps/tamanu-mobile-only/distribution_groups/staging',
  },
  disk: {
    diskPath: '/',
  },
  schedules: {
    fhirMaterialiser: {
      limit: 1000,
    },
  },
  integrations: {
    vdsNc: {
      enabled: false,
    },
    signer: {
      enabled: false,
    },
    fhir: {
      enabled: true,
      worker: {
        enabled: true,
        resourceMaterialisationEnabled: {
          Patient: true,
          Encounter: true,
          Immunization: true,
          MediciReport: true,
          Organization: true,
          Practitioner: true,
          ServiceRequest: true,
          MedicationRequest: true,
          Specimen: true,
        },
      },
    },
    mSupply: {
      enabled: true,
    },
  },
  notifications: {
    certificates: {
      labTestCategoryIds: ['labTestCategory-COVID', 'labTestCategory-COVIDRAT'],
    },
  },
  reportSchemas: {
    enabled: true,
    connections: {
      raw: {
        username: 'tamanu_raw_user',
        password: 'test',
      },
      reporting: {
        username: 'tamanu_reporting_user',
        password: 'test',
      },
    },
  },
}

