apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: '1'
  name: central-quiesce
  namespace: tamanu-main
spec:
  backoffLimit: 2
  template:
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - command:
        - sh
        - -c
        - |
          set +e
          /entrypoint just-migrate list --check
          status=$?
          set -e
          case "$status" in
            0) PENDING=no ;;
            3) PENDING=yes ;;
            *) echo "just-migrate list --check failed with exit $status" >&2; exit "$status" ;;
          esac
          export PENDING
          exec node --input-type=module -e "$QUIESCE_SCRIPT"
        env:
        - name: CRYPTO_KEY_FILE
          value: /secrets/configKey
        - name: CRYPTO_SETTINGS_PSK
          valueFrom:
            secretKeyRef:
              key: settingsPsk
              name: tamanu-crypto
        - name: TZ
          value: Pacific/Auckland
        - name: TAMANU_PRIMARY_TIMEZONE
          value: Pacific/Auckland
        - name: PROXY_TRUSTED
          value: loopback, 10.0.0.0/16, fd00::/48
        - name: DISK_PATH
          value: /
        - name: NODE_ENV
          value: staging
        - name: REVISION
          value: a25d1d4035
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              key: uri
              name: central-db-app
        - name: DB_HOST
          value: central-db-rw
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: central-db-app
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-db-app
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-db-app
        - name: TUPAIA_API_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: tupaia
        - name: TUPAIA_API_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: tupaia
        - name: MAILGUN_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: mailgun
        - name: MAILGUN_DOMAIN
          valueFrom:
            secretKeyRef:
              key: domain
              name: mailgun
        - name: MAILGUN_FROM
          valueFrom:
            secretKeyRef:
              key: from
              name: mailgun
        - name: BUGSNAG_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: bugsnag
        - name: AUTH_SECRET
          valueFrom:
            secretKeyRef:
              key: authSecret
              name: config-secrets-central
        - name: AUTH_REFRESH_SECRET
          valueFrom:
            secretKeyRef:
              key: authRefreshSecret
              name: config-secrets-central
        - name: QUIESCE_MODE
          value: quiesce
        - name: DEPLOYMENTS
          value: central-tasks,central-fhir-refresh,central-fhir-resolver,central-api
        - name: ANNOTATION
          value: tamanu.bes.au/replicas-before-migration
        - name: NODE_EXTRA_CA_CERTS
          value: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        - name: QUIESCE_SCRIPT
          value: |
            // Stops a server's processes while its migrator applies migrations, and starts
            // them again afterwards. Runs in the Tamanu image with `node -e`, so it uses only
            // Node built-ins and talks to the Kubernetes API as the pod's service account.
            // In quiesce mode it runs after `just-migrate list --check`, which has printed
            // the pending migrations to the log above this script's output.
            //
            // QUIESCE_MODE   `quiesce` or `resume`
            // DEPLOYMENTS    comma-separated names of the server's process Deployments
            // PENDING        (quiesce) `yes` when migrations are pending, `no` when not
            // ANNOTATION     where the replica count to restore is kept
            // WAIT_SECONDS   (quiesce) how long to wait for the processes' pods to go

            import { readFile } from 'node:fs/promises';
            import { setTimeout as sleep } from 'node:timers/promises';

            const SA = '/var/run/secrets/kubernetes.io/serviceaccount';
            const API = 'https://kubernetes.default.svc';
            const { QUIESCE_MODE, DEPLOYMENTS, PENDING, ANNOTATION, WAIT_SECONDS = '900' } = process.env;

            const namespace = (await readFile(`${SA}/namespace`, 'utf8')).trim();
            const token = (await readFile(`${SA}/token`, 'utf8')).trim();
            const deployments = DEPLOYMENTS.split(',').filter(Boolean);

            async function request(method, path, body) {
              const res = await fetch(`${API}${path}`, {
                method,
                headers: {
                  authorization: `Bearer ${token}`,
                  ...(body ? { 'content-type': 'application/merge-patch+json' } : {}),
                },
                body: body ? JSON.stringify(body) : undefined,
              });
              if (method === 'GET' && res.status === 404) return null;
              if (!res.ok) throw new Error(`${method} ${path}: ${res.status} ${await res.text()}`);
              return res.json();
            }

            const deploymentPath = name => `/apis/apps/v1/namespaces/${namespace}/deployments/${name}`;
            const scale = (name, replicas) =>
              request('PATCH', `${deploymentPath(name)}/scale`, { spec: { replicas } });
            const annotate = (name, value) =>
              request('PATCH', deploymentPath(name), { metadata: { annotations: { [ANNOTATION]: value } } });

            async function podsOf(deployment) {
              const selector = Object.entries(deployment.spec.selector.matchLabels ?? {})
                .map(([key, value]) => `${key}=${value}`)
                .join(',');
              const pods = await request(
                'GET',
                `/api/v1/namespaces/${namespace}/pods?labelSelector=${encodeURIComponent(selector)}`,
              );
              return pods.items.map(pod => pod.metadata.name);
            }

            async function quiesce() {
              // Anything but a clear `no` stops the servers: running them against a
              // database mid-migration is the failure this guards against.
              if (PENDING === 'no') {
                console.log('No migrations pending, leaving the servers running');
                return;
              }
              console.log('Migrations pending, stopping the servers');

              const stopping = [];
              for (const name of deployments) {
                const deployment = await request('GET', deploymentPath(name));
                if (!deployment) continue;
                // A retry after a failed migration finds the annotation already set and
                // keeps it, so the count restored is the one from before the first attempt.
                if (deployment.metadata.annotations?.[ANNOTATION] === undefined) {
                  await annotate(name, String(deployment.spec.replicas ?? 1));
                }
                await scale(name, 0);
                console.log(`Scaled ${name} to 0`);
                stopping.push(deployment);
              }

              const deadline = Date.now() + Number(WAIT_SECONDS) * 1000;
              for (;;) {
                const remaining = (await Promise.all(stopping.map(podsOf))).flat();
                if (remaining.length === 0) break;
                if (Date.now() > deadline) {
                  throw new Error(`Pods still running after ${WAIT_SECONDS}s: ${remaining.join(', ')}`);
                }
                console.log(`Waiting for ${remaining.length} pods to stop: ${remaining.join(', ')}`);
                await sleep(5000);
              }
              console.log('Servers stopped');
            }

            async function resume() {
              for (const name of deployments) {
                const deployment = await request('GET', deploymentPath(name));
                const recorded = deployment?.metadata.annotations?.[ANNOTATION];
                if (recorded === undefined) continue;
                const replicas = Number.parseInt(recorded, 10);
                if (!Number.isInteger(replicas) || replicas < 0) {
                  throw new Error(`${name}: ${ANNOTATION} is not a replica count: ${recorded}`);
                }
                await scale(name, replicas);
                await annotate(name, null);
                console.log(`Scaled ${name} back to ${replicas}`);
              }
            }

            if (QUIESCE_MODE === 'quiesce') await quiesce();
            else if (QUIESCE_MODE === 'resume') await resume();
            else throw new Error(`Unknown QUIESCE_MODE: ${QUIESCE_MODE}`);
        image: ghcr.io/beyondessential/tamanu-central:sha-a25d1d40354fd2d38442bce75328310ca37abae9
        imagePullPolicy: IfNotPresent
        name: quiesce
        resources:
          limits:
            memory: 1Gi
          requests:
            cpu: 5m
            memory: 256Mi
        volumeMounts:
        - mountPath: /config
          name: config-volume
        - mountPath: /secrets
          name: crypto-key
          readOnly: true
      restartPolicy: Never
      serviceAccountName: tamanu-quiesce
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
      volumes:
      - configMap:
          name: config-central
        name: config-volume
      - name: crypto-key
        secret:
          defaultMode: 256
          items:
          - key: configKey
            path: configKey
          secretName: tamanu-crypto
---
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: '3'
  name: central-resume
  namespace: tamanu-main
spec:
  backoffLimit: 2
  template:
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - command:
        - node
        - --input-type=module
        - -e
        - |
          // Stops a server's processes while its migrator applies migrations, and starts
          // them again afterwards. Runs in the Tamanu image with `node -e`, so it uses only
          // Node built-ins and talks to the Kubernetes API as the pod's service account.
          // In quiesce mode it runs after `just-migrate list --check`, which has printed
          // the pending migrations to the log above this script's output.
          //
          // QUIESCE_MODE   `quiesce` or `resume`
          // DEPLOYMENTS    comma-separated names of the server's process Deployments
          // PENDING        (quiesce) `yes` when migrations are pending, `no` when not
          // ANNOTATION     where the replica count to restore is kept
          // WAIT_SECONDS   (quiesce) how long to wait for the processes' pods to go

          import { readFile } from 'node:fs/promises';
          import { setTimeout as sleep } from 'node:timers/promises';

          const SA = '/var/run/secrets/kubernetes.io/serviceaccount';
          const API = 'https://kubernetes.default.svc';
          const { QUIESCE_MODE, DEPLOYMENTS, PENDING, ANNOTATION, WAIT_SECONDS = '900' } = process.env;

          const namespace = (await readFile(`${SA}/namespace`, 'utf8')).trim();
          const token = (await readFile(`${SA}/token`, 'utf8')).trim();
          const deployments = DEPLOYMENTS.split(',').filter(Boolean);

          async function request(method, path, body) {
            const res = await fetch(`${API}${path}`, {
              method,
              headers: {
                authorization: `Bearer ${token}`,
                ...(body ? { 'content-type': 'application/merge-patch+json' } : {}),
              },
              body: body ? JSON.stringify(body) : undefined,
            });
            if (method === 'GET' && res.status === 404) return null;
            if (!res.ok) throw new Error(`${method} ${path}: ${res.status} ${await res.text()}`);
            return res.json();
          }

          const deploymentPath = name => `/apis/apps/v1/namespaces/${namespace}/deployments/${name}`;
          const scale = (name, replicas) =>
            request('PATCH', `${deploymentPath(name)}/scale`, { spec: { replicas } });
          const annotate = (name, value) =>
            request('PATCH', deploymentPath(name), { metadata: { annotations: { [ANNOTATION]: value } } });

          async function podsOf(deployment) {
            const selector = Object.entries(deployment.spec.selector.matchLabels ?? {})
              .map(([key, value]) => `${key}=${value}`)
              .join(',');
            const pods = await request(
              'GET',
              `/api/v1/namespaces/${namespace}/pods?labelSelector=${encodeURIComponent(selector)}`,
            );
            return pods.items.map(pod => pod.metadata.name);
          }

          async function quiesce() {
            // Anything but a clear `no` stops the servers: running them against a
            // database mid-migration is the failure this guards against.
            if (PENDING === 'no') {
              console.log('No migrations pending, leaving the servers running');
              return;
            }
            console.log('Migrations pending, stopping the servers');

            const stopping = [];
            for (const name of deployments) {
              const deployment = await request('GET', deploymentPath(name));
              if (!deployment) continue;
              // A retry after a failed migration finds the annotation already set and
              // keeps it, so the count restored is the one from before the first attempt.
              if (deployment.metadata.annotations?.[ANNOTATION] === undefined) {
                await annotate(name, String(deployment.spec.replicas ?? 1));
              }
              await scale(name, 0);
              console.log(`Scaled ${name} to 0`);
              stopping.push(deployment);
            }

            const deadline = Date.now() + Number(WAIT_SECONDS) * 1000;
            for (;;) {
              const remaining = (await Promise.all(stopping.map(podsOf))).flat();
              if (remaining.length === 0) break;
              if (Date.now() > deadline) {
                throw new Error(`Pods still running after ${WAIT_SECONDS}s: ${remaining.join(', ')}`);
              }
              console.log(`Waiting for ${remaining.length} pods to stop: ${remaining.join(', ')}`);
              await sleep(5000);
            }
            console.log('Servers stopped');
          }

          async function resume() {
            for (const name of deployments) {
              const deployment = await request('GET', deploymentPath(name));
              const recorded = deployment?.metadata.annotations?.[ANNOTATION];
              if (recorded === undefined) continue;
              const replicas = Number.parseInt(recorded, 10);
              if (!Number.isInteger(replicas) || replicas < 0) {
                throw new Error(`${name}: ${ANNOTATION} is not a replica count: ${recorded}`);
              }
              await scale(name, replicas);
              await annotate(name, null);
              console.log(`Scaled ${name} back to ${replicas}`);
            }
          }

          if (QUIESCE_MODE === 'quiesce') await quiesce();
          else if (QUIESCE_MODE === 'resume') await resume();
          else throw new Error(`Unknown QUIESCE_MODE: ${QUIESCE_MODE}`);
        env:
        - name: QUIESCE_MODE
          value: resume
        - name: DEPLOYMENTS
          value: central-tasks,central-fhir-refresh,central-fhir-resolver,central-api
        - name: ANNOTATION
          value: tamanu.bes.au/replicas-before-migration
        - name: NODE_EXTRA_CA_CERTS
          value: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        image: ghcr.io/beyondessential/tamanu-central:sha-a25d1d40354fd2d38442bce75328310ca37abae9
        imagePullPolicy: IfNotPresent
        name: quiesce
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 10m
            memory: 64Mi
      restartPolicy: Never
      serviceAccountName: tamanu-quiesce
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
  name: central-api
  namespace: tamanu-main
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: api-server
      app.kubernetes.io/name: central
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
  name: central-web
  namespace: tamanu-main
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: web
      app.kubernetes.io/name: central
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
  name: central-api
  namespace: tamanu-main
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  selector:
    app.kubernetes.io/component: api-server
    app.kubernetes.io/name: central
  trafficDistribution: PreferClose
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
    tailscale.com/hostname: k8s-pg-main
    tailscale.com/tags: tag:k8s,tag:k8s-proxy,tag:server,tag:server-tamanu
  name: central-db-tailscale
  namespace: tamanu-main
spec:
  allocateLoadBalancerNodePorts: false
  loadBalancerClass: tailscale
  ports:
  - name: postgresql
    port: 5432
    protocol: TCP
    targetPort: 5432
  selector:
    cnpg.io/cluster: central-db
    cnpg.io/instanceRole: primary
  type: LoadBalancer
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
  name: central-web
  namespace: tamanu-main
spec:
  clusterIP: None
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  selector:
    app.kubernetes.io/component: web
    app.kubernetes.io/name: central
