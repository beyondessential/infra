        - mountPath: /secrets
          name: crypto-key
          readOnly: true
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
      volumes:
      - configMap:
          name: config-central
        name: config-volume
      - name: crypto-key
        secret:
