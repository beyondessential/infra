---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
    cert-manager.io/cluster-issuer: letsencrypt
    cert-manager.io/private-key-algorithm: ECDSA
  name: central
  namespace: tamanu-main
spec:
  gatewayClassName: envoy-gateway
  listeners:
  - hostname: central.main.cd.tamanu.app
    name: central
    port: 443
    protocol: HTTPS
    tls:
      certificateRefs:
      - kind: Secret
        name: central-termination-tls
      mode: Terminate
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
  name: central-api
  namespace: tamanu-main
spec:
  parentRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: central
    namespace: tamanu-main
  rules:
  - backendRefs:
    - name: central-api
      namespace: tamanu-main
      port: 80
    matches:
    - path:
        value: /api
    timeouts:
      request: 60s
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '4'
