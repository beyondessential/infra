          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - args:
        - setupSync
        env:
        - name: SYNC_URL
          value: https://admin%40tamanu.io:fixture@central.main.cd.tamanu.app/
        - name: CRYPTO_KEY_FILE
          value: /secrets/configKey
        - name: CRYPTO_SETTINGS_PSK
          valueFrom:
            secretKeyRef:
              key: settingsPsk
              name: tamanu-crypto
        - name: TZ
          value: Pacific/Auckland
        - name: TAMANU_PRIMARY_TIMEZONE
          value: Pacific/Auckland
        - name: PROXY_TRUSTED
