apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '3'
  name: central-web
  namespace: tamanu-main
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/component: web
      app.kubernetes.io/name: central
  template:
    metadata:
      labels:
        app.kubernetes.io/component: web
        app.kubernetes.io/name: central
        app.kubernetes.io/version: sha-a25d1d40354fd2d38442bce75328310ca37abae9
        billing.deployment: engineering
        billing.product: tamanu
        billing.stage: test
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - env:
        - name: PORT
          value: '3000'
        - name: NODE_ENV
          value: production
        - name: REVISION
          value: a25d1d4035
        - name: BUGSNAG_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: bugsnag
        image: ghcr.io/beyondessential/tamanu-frontend:sha-a25d1d40354fd2d38442bce75328310ca37abae9
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 2
          httpGet:
            path: /
            port: 3000
          periodSeconds: 10
        name: http
        ports:
        - containerPort: 3000
          name: http
        resources:
          limits:
            memory: 100Mi
          requests:
            cpu: 1m
            memory: 10Mi
        startupProbe:
          failureThreshold: 60
          httpGet:
            path: /
            port: 3000
          periodSeconds: 1
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
      topologySpreadConstraints:
      - labelSelector:
          matchLabels:
            app.kubernetes.io/component: web
            app.kubernetes.io/name: central
            app.kubernetes.io/version: sha-a25d1d40354fd2d38442bce75328310ca37abae9
        matchLabelKeys:
        - pod-template-hash
        maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '3'
    cert-manager.io/cluster-issuer: letsencrypt
    cert-manager.io/private-key-algorithm: ECDSA
  name: central
  namespace: tamanu-main
spec:
  gatewayClassName: envoy-gateway
  listeners:
  - hostname: central.main.cd.tamanu.app
    name: central
    port: 443
    protocol: HTTPS
    tls:
      certificateRefs:
      - kind: Secret
        name: central-termination-tls
      mode: Terminate
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: '3'
  name: central-api
  namespace: tamanu-main
spec:
  parentRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: central
    namespace: tamanu-main
  rules:
  - backendRefs:
    - name: central-api
