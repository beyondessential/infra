apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: '1'
  name: central-migrator
  namespace: tamanu-main
spec:
  backoffLimit: 5
  template:
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - args:
        - migrate
        env:
        - name: CRYPTO_KEY_FILE
          value: /secrets/configKey
        - name: CRYPTO_SETTINGS_PSK
          valueFrom:
            secretKeyRef:
              key: settingsPsk
              name: tamanu-crypto
        - name: TZ
          value: Pacific/Auckland
        - name: TAMANU_PRIMARY_TIMEZONE
          value: Pacific/Auckland
        - name: PROXY_TRUSTED
          value: loopback, 10.0.0.0/16, fd00::/48
        - name: DISK_PATH
          value: /
        - name: NODE_ENV
          value: production
        - name: REVISION
          value: a25d1d4035
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              key: uri
              name: central-db-app
        - name: DB_HOST
          value: central-db-rw
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: central-db-app
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-db-app
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-db-app
        - name: TUPAIA_API_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: tupaia
        - name: TUPAIA_API_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: tupaia
        - name: MAILGUN_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: mailgun
        - name: MAILGUN_DOMAIN
          valueFrom:
            secretKeyRef:
              key: domain
              name: mailgun
        - name: MAILGUN_FROM
          valueFrom:
            secretKeyRef:
              key: from
              name: mailgun
        - name: BUGSNAG_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: bugsnag
        - name: DB_RAW_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-raw-db
        - name: DB_RAW_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: central-raw-db
        - name: DB_REPORTING_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: central-reporting-db
        - name: DB_REPORTING_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: central-reporting-db
        - name: AUTH_SECRET
          valueFrom:
            secretKeyRef:
              key: authSecret
              name: config-secrets-central
        - name: AUTH_REFRESH_SECRET
          valueFrom:
            secretKeyRef:
              key: authRefreshSecret
              name: config-secrets-central
        image: ghcr.io/beyondessential/tamanu-central:sha-a25d1d40354fd2d38442bce75328310ca37abae9
        imagePullPolicy: IfNotPresent
        name: migrator
        resources:
          requests:
            cpu: 5m
            memory: 256Mi
        volumeMounts:
        - mountPath: /config
          name: config-volume
        - mountPath: /secrets
          name: crypto-key
          readOnly: true
        - mountPath: /app/packages/central-server/data/blobs
          name: blob-store
      restartPolicy: Never
      serviceAccountName: app-sa
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
      volumes:
      - configMap:
          name: config-central
        name: config-volume
      - name: crypto-key
        secret:
          defaultMode: 256
          items:
          - key: configKey
            path: configKey
          secretName: tamanu-crypto
      - name: blob-store
        persistentVolumeClaim:
          claimName: central-blobs
---
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: '2'
  name: central-provisioner
  namespace: tamanu-main
spec:
  backoffLimit: 2
  template:
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
