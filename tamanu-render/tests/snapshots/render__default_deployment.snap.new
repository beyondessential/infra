apiVersion: apps/v1
kind: Deployment
metadata:
  name: patient-portal-web
  namespace: tamanu-main
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: web
      app.kubernetes.io/name: patient-portal
  template:
    metadata:
      labels:
        app.kubernetes.io/component: web
        app.kubernetes.io/name: patient-portal
        app.kubernetes.io/version: sha-a25d1d40354fd2d38442bce75328310ca37abae9
        billing.deployment: engineering
        billing.product: tamanu
        billing.stage: test
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: bes.node.schedule
                operator: In
                values:
                - spot
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: bes.node.arch
                operator: In
                values:
                - arm64
              - key: bes.node.purpose
                operator: In
                values:
                - workload
      containers:
      - env:
        - name: PORT
          value: '3000'
        - name: NODE_ENV
          value: staging
        - name: REVISION
          value: a25d1d4035
        - name: BUGSNAG_API_KEY
          valueFrom:
            secretKeyRef:
              key: apiKey
              name: bugsnag
        image: ghcr.io/beyondessential/tamanu-patient-portal:sha-a25d1d40354fd2d38442bce75328310ca37abae9
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 2
          httpGet:
            path: /
            port: 3000
          periodSeconds: 10
        name: http
        ports:
        - containerPort: 3000
          name: http
        resources:
          limits:
            memory: 100Mi
          requests:
            cpu: 1m
            memory: 10Mi
        startupProbe:
          failureThreshold: 60
          httpGet:
            path: /
            port: 3000
          periodSeconds: 1
      tolerations:
      - effect: PreferNoSchedule
        key: spotInstance
        operator: Equal
        value: 'true'
